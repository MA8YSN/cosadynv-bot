# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Application (Client) ID from the "General Information" tab
DISCORD_CLIENT_ID=

# Guild (server) ID to register commands to instantly during development.
# Guild-scoped commands update in seconds; global commands take up to 1hr.
# Leave empty once you switch to global deployment in production.
DISCORD_GUILD_ID=

# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard -> Project Settings -> API
SUPABASE_URL=

# Use the service_role key (server-side only, bypasses RLS).
# NEVER expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────
# development | production
NODE_ENV=development
